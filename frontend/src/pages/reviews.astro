---
import Layout from '../components/Layout.astro';
---

<Layout title="Reviews" description="Guest reviews for Sapala.Fun properties">
  <section class="section reviews-page">
    <h1>Guest Reviews</h1>
    <p>Read what our guests have to say about their stay.</p>
    
    {/* Placeholder for reviews */}
    <div class="reviews-placeholder">
      <p> Guest reviews integration coming soon. </p>
    </div>
  </section>
</Layout>

<style>
.reviews-page {
  padding: 2rem 1rem;
}

.reviews-page h1 {
  font-family: 'Playfair Display', serif;
  margin-bottom: 1rem;
}

.reviews-placeholder {
  padding: 3rem;
  text-align: center;
  background: #f5f5f5;
  border-radius: 8px;
}
</style>
