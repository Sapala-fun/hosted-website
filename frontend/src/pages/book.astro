---
import Layout from '../components/Layout.astro';
import { apiBaseUrl } from '../config/site';

const ownerRezBookingUrl = 'https://www.ownerrez.com/book/your-booking-url-here';
---

<Layout title="Book Your Stay" description="Reserve your oceanfront villa in St. Croix">
  <section class="booking-section">
    <div class="booking-card">
      <span class="section-label">Reservation</span>
      <h1>Book Your Stay</h1>
      <p class="section-subtitle">Complete your reservation through OwnerRez's secure booking platform.</p>

      <a href={ownerRezBookingUrl} target="_blank" rel="noopener" class="btn-book" style="font-size:1rem; padding:1rem 2.5rem;">
        Proceed to Booking →
      </a>

      <div class="booking-features">
        <div class="booking-feature">
          <div class="booking-feature-icon">🔒</div>
          <p>Secure Payment</p>
        </div>
        <div class="booking-feature">
          <div class="booking-feature-icon">⚡</div>
          <p>Instant Confirmation</p>
        </div>
        <div class="booking-feature">
          <div class="booking-feature-icon">↩️</div>
          <p>Free Cancellation</p>
        </div>
      </div>

      <div style="margin-top:2.5rem; padding-top:2rem; border-top:1px solid var(--color-border);">
        <h3 style="font-size:1.1rem; margin-bottom:0.5rem;">Need help?</h3>
        <p style="color:var(--color-text-muted); font-size:0.95rem;">
          Contact us at <a href="mailto:info@sapala.fun" style="color:var(--color-accent-dark); font-weight:600;">info@sapala.fun</a> or call us directly.
        </p>
      </div>
    </div>
  </section>
</Layout>
