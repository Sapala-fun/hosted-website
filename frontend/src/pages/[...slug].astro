---
import Layout from '../components/Layout.astro';
import type { Property } from '../types';

export function getStaticPaths() {
  const properties: Property[] = [
    {
      id: 'orp5b5eae5x',
      slug: 'sapala-all-exclusive-oceanfront-villa-with-private-pool',
      name: 'Sapala All',
      description: 'Incredible waterfront location for this large 5 bedroom rustic home on the sparkling shore of the Caribbean Sea. Walking distance to a nearby beach and the Nature Conservatory\'s Jacks & Issac\'s Bay.',
      bedrooms: 5,
      bathrooms: 5,
      sleeps: '11-13',
      nightlyRateMin: 329,
      nightlyRateMax: 998,
      imageUrl: 'https://uc.orez.io/i/9599e9fcddb8413b99fd699d1e3ba720-Large',
    },
    {
      id: 'orp5b5e872x',
      slug: 'sapala-1-oceanfront-main-house-with-shared-pool',
      name: 'Sapala 1',
      description: 'Incredible waterfront location for this large 4 bedroom home on the sparkling shore of the Caribbean Sea. Walking distance to a nearby beach and the Nature Conservatory\'s Jacks & Issac\'s Bay.',
      bedrooms: 4,
      bathrooms: 4,
      sleeps: '8-10',
      nightlyRateMin: 269,
      nightlyRateMax: 398,
      imageUrl: 'https://uc.orez.io/i/426f5eb83b954ef1b32ac2bfe7e1d365-Large',
    },
    {
      id: 'orp5b5e89fx',
      slug: 'sapala-2-oceanfront-poolside-apt-with-shared-pool',
      name: 'Sapala 2',
      description: 'Take it easy at this unique and tranquil getaway. A one bedroom Poolside Apt facing the ocean. Walking distance to a nearby beach and the Nature Conservatory\'s Jacks & Issac\'s Bay.',
      bedrooms: 1,
      bathrooms: 1,
      sleeps: '2',
      nightlyRateMin: 119,
      nightlyRateMax: 198,
      imageUrl: 'https://uc.orez.io/i/157958a328be436bbeb0b84aced8e300-Large',
    },
  ];

  return properties.map((prop) => ({
    params: { slug: prop.slug },
    props: { property: prop },
  }));
}

const { property } = Astro.props;

const galleryImages = [
  'https://uc.orez.io/i/9599e9fcddb8413b99fd699d1e3ba720-Large',
  'https://uc.orez.io/i/426f5eb83b954ef1b32ac2bfe7e1d365-Large',
  'https://uc.orez.io/i/e7e37099016e4809b95b8e47c4d97051-Large',
  'https://uc.orez.io/i/e54326e81085452d8cf7d08549812254-Large',
  'https://uc.orez.io/i/3c7a5a5e041d428da773b238a6d16f82-Large',
  'https://uc.orez.io/i/4e4eef5ea214b219377738f20deef16-Large',
];

const amenities = [
  { category: 'Listing Type', value: 'Villa' },
  { category: 'Accommodation', value: 'Entire Home' },
  { category: 'Check-In', value: 'Lockbox' },
  { category: 'Setting & View', value: 'Oceanfront, Ocean View' },
  { category: 'Internet / Wifi', value: 'Yes' },
  { category: 'Air Conditioning', value: 'Yes' },
  { category: 'Kitchen', value: 'Full Kitchen' },
  { category: 'Pool/Spa', value: 'Private Pool' },
  { category: 'Vehicles', value: 'Free Parking' },
];

const cancellationPolicy = 'One hundred percent (100.00%) of the total booking charges will be refunded if the cancellation is made more than 60 days prior to the arrival date. Fifty percent (50.00%) will be refunded if more than 30 days prior. For cancellations within 30 days, no refund.';
---

<Layout title={property.name} description={property.description}>
  <!-- Hero -->
  <div class="detail-hero" style={`background-image: url('${property.imageUrl}');`}>
    <div class="hero-overlay"></div>
    <div class="hero-content">
      <h1>{property.name}</h1>
      <p>${property.nightlyRateMin}&ndash;${property.nightlyRateMax}/night &middot; {property.bedrooms} Bedrooms &middot; {property.bathrooms} Bathrooms &middot; Sleeps {property.sleeps}</p>
    </div>
  </div>

  <!-- Detail Body -->
  <div class="detail-body">
    <div class="detail-main">
      <h2>About</h2>
      <p>{property.description}</p>

      <h2 style="margin-top:3rem;">Rates &amp; Cancellation</h2>
      <div class="rate-card">
        <h3>Cancellation Policy</h3>
        <p>{cancellationPolicy}</p>
      </div>

      <h2 style="margin-top:3rem;">Amenities</h2>
      <table class="amenities-table" style="margin-top:1rem;">
        {amenities.map((a) => (
          <tr>
            <th>{a.category}</th>
            <td>{a.value}</td>
          </tr>
        ))}
      </table>

      <h2 style="margin-top:3rem;">Photos</h2>
      <div class="gallery-grid" style="margin-top:1rem;">
        {galleryImages.map((img) => (
          <img src={img} alt="Property photo" loading="lazy" />
        ))}
      </div>

      <h2 style="margin-top:3rem;">Location</h2>
      <p style="color:var(--color-text-muted); margin-top:0.5rem;">Christiansted, St. Croix, USVI, Virgin Islands (U.S.)</p>
    </div>

    <!-- Sidebar -->
    <aside class="detail-sidebar">
      <div class="sidebar-card">
        <p class="sidebar-price-label">Starting from</p>
        <p class="sidebar-price">${property.nightlyRateMin}<span style="font-size:1rem; color:var(--color-text-muted); font-weight:400;">/night</span></p>
        <a href="/book" class="sidebar-btn">Book Now</a>
      </div>
      <div class="sidebar-card sidebar-contact">
        <h3>Contact Us</h3>
        <p><a href="mailto:info@sapala.fun">info@sapala.fun</a></p>
      </div>
    </aside>
  </div>
</Layout>
