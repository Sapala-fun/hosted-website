---
import Layout from '../components/Layout.astro';
---

<Layout title="Availability" description="Check availability for Sapala.Fun properties">
  <section class="section availability-page">
    <h1>Availability</h1>
    <p>Check availability for all properties.</p>
    
    {/* Placeholder for availability calendar */}
    <div class="availability-calendar-placeholder">
      <p> Availability calendar integration coming soon. </p>
    </div>
  </section>
</Layout>

<style>
.availability-page {
  padding: 2rem 1rem;
}

.availability-page h1 {
  font-family: 'Playfair Display', serif;
  margin-bottom: 1rem;
}

.availability-calendar-placeholder {
  padding: 3rem;
  text-align: center;
  background: #f5f5f5;
  border-radius: 8px;
}
</style>
