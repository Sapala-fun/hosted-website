# OwnerRez API credentials (used by Go backend)
# Get your personal token from: https://www.ownerrez.com/settings/api

OWNERREZ_API_BASE_URL="https://api.ownerrez.com"
OWNERREZ_EMAIL="your-email@example.com"
OWNERREZ_PERSONAL_TOKEN="your-personal-token-here"
# OWNERREZ_API_KEY="your-api-key-here"  # Alternative: HTTP Basic auth (base64 encoded)
# OWNERREZ_OAUTH_TOKEN="your-oauth-token-here"  # Future: OAuth 2.0 (bearer token)
